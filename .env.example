# 复制为 .env 后按需填写（程序只读取环境变量，不会自动加载此文件；PowerShell 中用 $env:NAME="value" 设置）
# 两个 key 都不填时为回放模式：只回放 data/replay/ 和向量缓存里真实调用录下的结果，完全离线、零费用。

# 百炼（向量、重排；LLM_PROVIDER=qwen 时也用于回答生成）
DASHSCOPE_API_KEY=
# DeepSeek（LLM_PROVIDER=deepseek 时用于回答生成）
LLM_API_KEY=

# 回答生成：deepseek 或 qwen
LLM_PROVIDER=deepseek
# 留空则用默认：deepseek -> deepseek-flash，qwen -> qwen-plus
LLM_MODEL=

# live | replay（有两个 key 时默认 live）
CATALOG_MODE=
# 1 = 把真实调用的返回保存到 data/replay/（按检索流程打标签）
CATALOG_RECORD=0
# bm25 | hybrid | hybrid_rerank（默认）
CATALOG_PIPELINE=hybrid_rerank

# 向量与重排模型
EMBED_MODEL=text-embedding-v4
EMBED_DIM=512
RERANK_MODEL=gte-rerank-v2

# 报价草稿：目标价与协议价的容差（默认 2%）
PRICE_TOLERANCE=0.02

# 飞书自建应用（长连接，无需公网地址）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 未在映射表里的用户的角色（默认 客服，最小权限）
FEISHU_DEFAULT_ROLE=客服
# open_id 到角色的映射，例如 ou_xxx:销售,ou_yyy:客服
FEISHU_USER_ROLES=
# 1 = 允许消息以 #销售 / #客服 开头切换角色（仅供演示）
FEISHU_ALLOW_ROLE_TAG=0
